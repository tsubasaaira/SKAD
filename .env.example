# PUBLIC Firebase web config: these values will be included in the browser build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY: set as Cloudflare Pages environment variables/secrets. Never prefix secrets with VITE_.
# Put the whole Firebase service-account JSON on one line, without surrounding quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional AI generation. Manual activity creation works without it.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional Gemini TTS model (default: gemini-3.8-flash-lite-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
